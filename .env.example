# Example only; this file is not automatically loaded.
APP_ORIGIN=http://localhost:8000
ECHOCHECK_MODE=prototype
RELEASE_ENABLED=false
ECHOCHECK_DB=./work/echocheck-v02.db
ECHOCHECK_AUDIO_DIR=./work/private-audio
# Select an approved model supporting audio and structured output.
GEMINI_MODEL=
# vertex = Gemini on Vertex AI via the runtime service account (no key); api_key = Gemini API key
GEMINI_BACKEND=api_key
VERTEX_PROJECT=
VERTEX_LOCATION=global
GEMINI_API_KEY=
# Optional free-tier pacing between Gemini calls, in seconds (0 = off)
GEMINI_MIN_INTERVAL_SECONDS=0
PROVIDER_PROCESSING_ENABLED=false
CONSENT_VERSION=2026-10-18-v1
SESSION_SECONDS=28800
RECORDING_TICKET_SECONDS=300
RECORDING_PROCESSING_SECONDS=180
RECORDING_RETENTION_SECONDS=604800
# Only explicit trusted reverse-proxy IPs/networks. Blank trusts no proxy headers.
TRUSTED_PROXY_IPS=
# Deployment placeholders:
GOOGLE_CLOUD_PROJECT_ID=
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
